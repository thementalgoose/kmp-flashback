{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "Dependency Update"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchPackageNames": [
        "/^androidx\\.xr\\./"
      ],
      "enabled": false
    },
    {
      "matchPackagePatterns": [
        "/^io\\.insert-koin:/"
      ],
      "excludeVersions": ["4.1.1"]
    }
  ]
}
