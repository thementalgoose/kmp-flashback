{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "Dependency Update"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchPackageNames": [
        "/^androidx\\.xr\\./"
      ],
      "enabled": false
    },
    {
      "matchPackagePatterns": [
        "/^io\\.insert-koin:/"
      ],
      "excludeVersions": ["4.1.1"]
    },
    {
      "matchPackageNames": [
        "/^androidx\\.compose\\.ui:ui-test-manifest/"
      ],
      "excludeVersions": ["/^1\\.10\\."]
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains.\\compose\\.material3\\.adaptive:adaptive-navigation3/"
      ],
      "excludeVersions": ["1.3.0-alpha04"]
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.androidx\\.lifecycle:lifecycle-viewmodel-navigation3/"
      ],
      "excludeVersions": ["2.10.0-alpha08"]
    }
  ]
}
